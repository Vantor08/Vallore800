<div class="wrap" style="max-width:720px;margin:0 auto;padding:48px 20px">
  <h1 style="font-family:'Fraunces',serif;color:#40162C">{{ article.title }}</h1>
  <p style="color:#9A8790;margin:6px 0 20px">{{ article.published_at | date: "%B %-d, %Y" }}</p>
  <div class="rte" style="line-height:1.7;color:#36232D">{{ article.content }}</div>
</div>
