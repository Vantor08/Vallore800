<div class="wrap" style="max-width:760px;margin:0 auto;padding:48px 20px">
  <h1 style="font-family:'Fraunces',serif;color:#40162C">{{ blog.title }}</h1>
  {% for article in blog.articles %}
  <div style="padding:18px 0;border-bottom:1px solid #ECDED9">
    <a href="{{ article.url }}" style="color:#40162C;font-weight:700;text-decoration:none">{{ article.title }}</a>
    <p style="color:#7A636B;margin:6px 0 0">{{ article.excerpt_or_content | strip_html | truncate: 150 }}</p>
  </div>
  {% endfor %}
</div>
