<div class="wrap" style="max-width:760px;margin:0 auto;padding:48px 20px">
  <h1 style="font-family:'Fraunces',serif;color:#40162C">Your cart</h1>
  {% if cart.item_count > 0 %}
  <form action="{{ routes.cart_url }}" method="post">
    {% for item in cart.items %}
    <div style="display:flex;gap:16px;align-items:center;padding:16px 0;border-bottom:1px solid #ECDED9">
      {% if item.image %}<img src="{{ item.image | image_url: width: 160 }}" width="76" height="76" style="border-radius:12px;object-fit:cover">{% endif %}
      <div style="flex:1"><b style="color:#40162C">{{ item.product.title }}</b><br><span style="color:#7A636B;font-size:14px">{{ item.variant.title }}</span></div>
      <div style="font-weight:700;color:#40162C">{{ item.final_line_price | money }}</div>
    </div>
    {% endfor %}
    <div style="display:flex;justify-content:space-between;margin:22px 0;font-size:18px;font-weight:800;color:#40162C"><span>Subtotal</span><span>{{ cart.total_price | money }}</span></div>
    <button type="submit" name="checkout" class="btn btn-lg" style="width:100%">Secure checkout</button>
  </form>
  {% else %}
  <p style="color:#7A636B;margin:16px 0 24px">Your cart is empty.</p>
  <a class="btn" href="{{ routes.root_url }}">Continue shopping</a>
  {% endif %}
</div>
