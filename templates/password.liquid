<div class="wrap" style="max-width:480px;margin:0 auto;padding:80px 20px;text-align:center">
  <h1 style="font-family:'Fraunces',serif;color:#40162C">{{ shop.name }}</h1>
  <p style="color:#7A636B;margin:12px 0 24px">Opening soon.</p>
  {% form 'storefront_password' %}
    {{ form.errors | default_errors }}
    <input type="password" name="password" placeholder="Enter password" style="padding:12px 16px;border:1px solid #ECDED9;border-radius:12px;width:100%;margin-bottom:12px">
    <button type="submit" class="btn" style="width:100%">Enter</button>
  {% endform %}
</div>
